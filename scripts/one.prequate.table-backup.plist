<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>one.prequate.table-backup</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>export PATH="$HOME/.local/node/bin:$PATH"; cd /Users/apple/prequate-table-portal &amp;&amp; node scripts/backup.cjs</string>
  </array>
  <!-- Twice a day. If the Mac is asleep at that time, it runs when it wakes. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>2</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>14</integer><key>Minute</key><integer>0</integer></dict>
  </array>
  <key>StandardOutPath</key>
  <string>/Users/apple/prequate-table-backups/backup.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/apple/prequate-table-backups/backup.log</string>
</dict>
</plist>
