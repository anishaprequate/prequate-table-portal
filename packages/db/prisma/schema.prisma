// Prequate Table member portal — data model.
// SQLite for the prototype. Swapping to Postgres for production is a
// datasource change plus a migration.
//
// SQLite's Prisma connector has no native enum type, so fields that would
// normally be enums (role, status, etc.) are plain strings here. The valid
// values for each are defined as TypeScript union types in
// packages/core/src/types.ts — read from there, not from this file.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// PRODUCTION NOTE (DPDPA): this table stores member personal data (name,
// phone, email, bio). A production release must add consent capture at
// collection, a documented retention period, and a data-deletion path
// before this holds real member data. Not built in this prototype.
model User {
  id              String  @id @default(cuid())
  // Role: "MEMBER" | "PARTNER" | "ADMIN_OWNER" | "ADMIN_RM" | "ADMIN_ASSOCIATE"
  role            String
  name            String
  phone           String? @unique
  email           String? @unique
  seatType        String?
  seatNumber      String? @unique
  // When this member was seated at the Table — distinct from `createdAt`
  // (record creation) and `firstLoginAt` (first login). Drives the Reserve
  // Hour's anniversary reset and the Room's reverse-of-seat caption.
  seatingDate     DateTime?
  // First-cohort members carry a small permanent mark on their seat in the
  // Room. A manually admin-set flag, not derived from seatingDate order.
  foundingCohort  Boolean @default(false)
  city            String?
  company         String?
  bio             String?
  // A longer form of `bio`, curated by an admin (typically from the
  // member's LinkedIn) and shown only behind "Read more" on the directory
  // profile — never sourced from internal notes or the audit timeline.
  longBio         String?
  linkedinUrl     String?
  photoUrl        String?
  directoryOptOut Boolean @default(false)

  // Admin-set tags used to build targeted event invite lists (e.g. invite
  // everyone in "FMCG" or everyone tagged "Second-generation"). Freeform,
  // not a fixed enum — the admin invite flow reads whatever values exist
  // across members to build its filter options.
  sector    String?
  archetype String?

  interests MemberInterest[]

  // Last time this member completed a login. Distinct from firstLoginAt —
  // used to surface "last used the app" on the admin member profile.
  lastActiveAt DateTime?

  // Dedup state for the daily inactivity cadence job (see
  // /api/cron/member-inactivity): when it flags a 60-day gap, it records
  // both when it flagged and what the member's last-touch date was at that
  // moment. It only flags again once a fresh touch after that moment is
  // followed by a new 60-day gap — never just because the same old gap is
  // still open.
  lastInactivityNotifiedAt    DateTime?
  lastInactivityNotifiedTouch DateTime?

  // LifecycleStatus: "PROSPECT" | "ACTIVE" | "AT_RISK" | "PAUSED" | "ALUMNI"
  // Only meaningful for role "MEMBER". Existing members default to ACTIVE;
  // new ones can be created as PROSPECT before they're formally seated.
  lifecycleStatus String @default("ACTIVE")

  // Privacy: whether a partner may open a direct message thread with this
  // member. Doesn't affect the RM thread, which always exists.
  allowPartnerMessages Boolean @default(true)

  // Email preferences — gate only the ambient reminder/blast/survey
  // emails below; transactional email (magic-link login, a booking's own
  // confirmation) always sends regardless of these.
  emailHourReminders Boolean @default(true)
  emailEventBlasts   Boolean @default(true)
  emailEventSurveys  Boolean @default(true)

  // Set the first time a member completes login. Gates the one-time
  // quiet-arrival screen — shown once, never again after.
  firstLoginAt DateTime?

  // Simulated NFC chip identifier. In production this is provisioned onto
  // the physical plate's chip; here it is a stand-in value used only by
  // the stubbed "tap" login screen to look up a member.
  chipUid String? @unique

  // Notion sync. Notion ("Table Leads Master") decides who is a member; the
  // portal decides activity. notionPageId links this account to its Notion
  // row. accessCodeHash is an HMAC of the plate access code (never the code
  // itself); once it has been used to log in, accessCodeRetiredAt is set and
  // the code no longer works for login. profileEditedFields is a JSON array
  // of profile fields the member edited in the portal, which the sync must
  // never overwrite. notionFlag marks a member whose Notion status moved to
  // Declined: only flagged for admin review, never deactivated.
  notionPageId        String?   @unique
  accessCodeHash      String?   @unique
  accessCodeRetiredAt DateTime?
  profileEditedFields String?
  notionSyncedAt      DateTime?
  notionFlag          String?

  // Home. homeSeenAt is when the member last opened Home, so "since you were
  // last here" has something to count from. tableLine is the member's own
  // sentence about what the table means to them.
  homeSeenAt DateTime?
  tableLine  String?

  // Meaningful only for role "PARTNER" — how many Hours they commit to
  // the Table each calendar month. Drives the Partner Availability panel's
  // scarcity line; deliberately separate from raw connected-calendar free
  // slots, which are far more numerous and would read as "wide open"
  // rather than the calm scarcity the panel is meant to convey.
  monthlyHourCapacity Int @default(4)

  // Admin console sign-in. username is stored lowercase and is unique; the
  // password is stored only as a scrypt hash ("scrypt$salt$hash"). Members
  // never have either: they sign in with a code or a plate.
  username     String? @unique
  passwordHash String?

  // Meaningful only for role "PARTNER": the Google calendar whose recurring
  // blocks mark the partner's Table hours. Empty until Google sync is set up.
  tableHoursCalendarId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  otpCodes                  OtpCode[]
  sessions                  Session[]
  bookingsAsMember          Booking[]                  @relation("MemberBookings")
  bookingsAsPartner         Booking[]                  @relation("PartnerBookings")
  briefsAuthored            Brief[]
  eventAttendances          EventAttendance[]
  memberThread              Message[]                  @relation("MemberThread")
  partnerThread             Message[]                  @relation("PartnerThread")
  messagesAuthored          Message[]                  @relation("MessageAuthor")
  insightPosts              InsightPost[]
  googleCalendarConnections GoogleCalendarConnection[]
  timelineEntries           MemberTimelineEntry[]      @relation("MemberTimeline")
  timelineAuthored          MemberTimelineEntry[]      @relation("TimelineAuthor")
  introductionsRequested    IntroductionRequest[]      @relation("IntroductionRequester")
  introductionsReceived     IntroductionRequest[]      @relation("IntroductionTarget")
  insightBookmarks          InsightBookmark[]
  insightViews              InsightView[]
  notifications             Notification[]
  eventBlastsSent           EventBlast[]
  eventPhotosUploaded       EventPhoto[]
  roomEventsAsSeat          RoomEvent[]                @relation("RoomEventMember")
  roomEventViews            RoomEventView[]            @relation("RoomEventViewer")
  eventsHosted              Event[]                    @relation("EventHost")
  availabilityBlocks        AvailabilityBlock[]
  questionReplies           EventQuestionReply[]
  tableRequests             TableRequest[]
}

// A fixed (but admin-editable) taxonomy of interest categories a member can
// select on their Profile — not freeform tags like `sector`/`archetype`.
// Seeded with ten starter categories; an owner or RM can add, rename, or
// remove categories later via Admin, so this list is data, not an enum.
model InterestCategory {
  id        String   @id @default(cuid())
  label     String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  members MemberInterest[]
}

model MemberInterest {
  id         String           @id @default(cuid())
  memberId   String
  member     User             @relation(fields: [memberId], references: [id])
  categoryId String
  category   InterestCategory @relation(fields: [categoryId], references: [id])
  createdAt  DateTime         @default(now())

  @@unique([memberId, categoryId])
}

// A member asking Prequate to broker an introduction to another member,
// browsed from the member directory. Tracked with its own
// status field so it doesn't get lost in a message thread.
model IntroductionRequest {
  id          String   @id @default(cuid())
  requesterId String
  requester   User     @relation("IntroductionRequester", fields: [requesterId], references: [id])
  targetId    String
  target      User     @relation("IntroductionTarget", fields: [targetId], references: [id])
  // Why the requester would like to be introduced — shown to the target
  // once routed, and back to the requester as a record of what they asked.
  message     String?
  // How the requester prefers to be contacted (email, phone, WhatsApp, etc).
  preferredChannel String?
  // Freeform — website, LinkedIn, company, whatever the requester wants the
  // target to see before deciding.
  contactDetails   String?
  // Status: "SENT" | "ACCEPTED" | "DECLINED" | "FULFILLED"
  status      String   @default("SENT")
  adminNote   String?

  // Set by an admin once they've reviewed the request and chosen to pass
  // it on. The target member only ever sees the request in their own
  // "Introductions" list after this is set — never as soon as it's sent.
  routedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A combined feed of manual notes and system-recorded changes on a member's
// record. Type "NOTE" is freeform and admin-editable; type "SYSTEM" is
// generated by the app itself (a status change, a profile edit) and is not
// meant to be edited after the fact — it's the audit trail.
model MemberTimelineEntry {
  id        String   @id @default(cuid())
  memberId  String
  member    User     @relation("MemberTimeline", fields: [memberId], references: [id])
  authorId  String
  author    User     @relation("TimelineAuthor", fields: [authorId], references: [id])
  // Type: "NOTE" | "SYSTEM"
  type      String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A single connected Google account whose calendar receives a real event
// for every Hour booking. Only one connection is expected at a time — the
// admin console's connect flow replaces any existing row rather than
// accumulating them.
//
// PRODUCTION NOTE: tokens are stored in plain text here, fine for a local
// prototype. A production version needs these encrypted at rest.
model GoogleCalendarConnection {
  id            String   @id @default(cuid())
  accountEmail  String   @unique
  accessToken   String
  refreshToken  String
  expiresAt     DateTime
  connectedById String
  connectedBy   User     @relation(fields: [connectedById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Phone + OTP login fallback. Codes are short-lived and single-use.
// PRODUCTION NOTE: this prototype has no SMS provider wired up, so the
// generated code is surfaced directly in the UI/response instead of sent
// by SMS. Replace with a real SMS/OTP provider before production.
model OtpCode {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  code       String
  // Channel: "phone" | "email" — same shape (a token tied to a user, with
  // an expiry and single-use consumption) serves both the phone OTP flow
  // (a short numeric code) and the email magic-link flow (a long opaque
  // token embedded in the link itself). Kept as one table rather than two
  // near-identical ones; channel exists so a lookup can't cross flows.
  channel    String    @default("phone")
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
}

// PRODUCTION NOTE: sessions here are a plain server-side token in a cookie,
// with no rotation, device binding, or hardened expiry handling. Sufficient
// for a prototype; needs real session hardening before production.
model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model Booking {
  id            String   @id @default(cuid())
  memberId      String
  member        User     @relation("MemberBookings", fields: [memberId], references: [id])
  partnerId     String
  partner       User     @relation("PartnerBookings", fields: [partnerId], references: [id])
  startTime     DateTime
  endTime       DateTime
  // Status: "REQUESTED" | "CONFIRMED" | "RESCHEDULE_REQUESTED" | "CANCELLED" | "COMPLETED" | "NO_SHOW"
  status        String   @default("REQUESTED")
  memberContext String?

  // How the Hour happens. Mode: "IN_PERSON" | "ONLINE". For an in person Hour
  // the logistics are agreed separately. For an online one, location holds the
  // Google Meet link that Google adds to the calendar event.
  mode     String @default("IN_PERSON")
  location String?

  // Set when this booking is a requested follow-up to an earlier session.
  parentBookingId String?
  parentBooking   Booking?  @relation("FollowUp", fields: [parentBookingId], references: [id])
  followUps       Booking[] @relation("FollowUp")

  // Id of the corresponding event in the partner's calendar. Backed by a
  // mock Google Calendar client in this prototype (see packages/core).
  googleCalendarEventId String?

  // Set once the 24-hours-before reminder email has gone out for this
  // booking, so the cron job (see apps/admin/src/app/api/cron) never
  // sends it twice.
  reminderSentAt DateTime?

  // Set when status becomes "CANCELLED" — used to distinguish a late
  // cancellation (cancelled less than 24 hours before startTime) from a
  // normal one.
  cancelledAt DateTime?
  // Always collected from whoever cancels (member or admin) — unlike the
  // event-cancellation reason, this one is required at the form level.
  cancellationReason String?

  // Set when the member taps their NFC card at the start of this session —
  // an automatic alternative to an admin marking attendance by hand. Purely
  // a check-in marker, independent of the final status (COMPLETED/NO_SHOW)
  // an admin still sets afterward.
  checkedInAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  briefs Brief[]
  offers BookingOffer[]
}

// Three alternative times offered to a member when a partner cancels or
// asks to move their Hour. One tap accepts one of them.
// Reason: "CANCELLED" | "RESCHEDULE". slots is a JSON array of
// { start, end } ISO strings. An offer is open until acceptedAt is set or
// expiresAt passes.
model BookingOffer {
  id             String    @id @default(cuid())
  bookingId      String
  booking        Booking   @relation(fields: [bookingId], references: [id])
  reason         String
  slots          String
  expiresAt      DateTime
  acceptedAt     DateTime?
  acceptedStart  DateTime?
  createdAt      DateTime  @default(now())
}

model Brief {
  id        String   @id @default(cuid())
  // What the partner posted after an Hour: "NOTES" (meeting notes), "BRIEF",
  // "OBSERVATION" (a follow-up observation) or "FILE".
  kind      String   @default("NOTES")
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id])
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  content   String?
  fileName  String?
  fileUrl   String?
  createdAt DateTime @default(now())
}

// Sourced from Luma in production; backed by a mock Luma client here (see
// packages/core/src/integrations/luma.ts). lumaEventId is the join key —
// null for an event created directly in the admin console with no Luma
// counterpart.
model Event {
  id                 String    @id @default(cuid())
  lumaEventId        String?   @unique
  title              String
  // Rich-text HTML, authored the same way as an InsightPost body — sanitized
  // on the way in, trusted on the way out.
  description        String?
  imageUrl           String?
  location           String?
  startTime          DateTime
  endTime            DateTime
  // Visibility: "VISIBLE_TO_ALL" | "HIDDEN"
  attendeeVisibility String    @default("HIDDEN")
  // Tier: "DINNER" | "QUARTERLY" | "ANNUAL"
  tier               String    @default("DINNER")
  adminNote          String?
  publishedAt        DateTime?
  createdAt          DateTime  @default(now())

  // Null means uncapped. Once the number of joined attendees (counting each
  // person's own guests) reaches this, further joins are waitlisted instead.
  capacity Int?

  // When true, only members with an invited=true EventAttendance row can
  // see or join this event — used for the Annual Gathering, but not tied to
  // any specific tier so any event can be made invite-only.
  inviteOnly Boolean @default(false)

  // When true, joining sets pendingApproval instead of joined — an admin
  // must approve (or decline) before the member is confirmed.
  approvalRequired Boolean @default(false)

  // JSON-encoded array of question strings an admin has added for this
  // event's RSVP form. Same parse/stringify-at-the-boundary convention as
  // elsewhere in this schema.
  registrationQuestions String?

  // Whether a member can bring anyone at all when they RSVP. Off by
  // default — an admin turns it on per event, deliberately, not a default.
  allowPlusOne Boolean @default(false)

  // A random token that resolves (via /events/invite/[token]) to granting
  // whoever opens it an invited=true row on this event — a link an admin
  // can generate and forward directly, instead of hand-picking names.
  inviteToken String? @unique

  // Annual Gathering-only fields (tier = "ANNUAL"), shown in the admin form
  // only when that tier is selected — kept on the same Event object rather
  // than a separate module, per the build note.
  sponsorName     String?
  sponsorLogoUrl  String?
  // JSON-encoded array of { name, email } for guests beyond the membership
  // — not tied to a Member record. Same parse/stringify-at-the-boundary
  // convention as elsewhere in this schema.
  externalGuests  String?

  // Soft-delete: deleting an event archives it instead of removing the
  // row, so it stays viewable (and restorable) rather than vanishing —
  // members never see an archived event, and it's excluded from the Live
  // and Draft tabs in Admin > Events, appearing only in Archive.
  archivedAt DateTime?

  // Cancelled is its own state, distinct from archived — the event isn't
  // happening, but (unlike an archived/deleted event) members who already
  // RSVP'd can still open it and see that it's cancelled. History (who'd
  // RSVP'd, who attended if it already happened) is preserved either way.
  // Also shown in the Archive tab, alongside archived events, but with its
  // own "Cancelled" label rather than "Archived".
  cancelledAt        DateTime?
  cancellationReason String?

  // Home. The question a dinner asks of its members, the partner who hosts
  // (only they read the replies), and the on-the-day details.
  dinnerQuestion String?
  hostPartnerId  String?
  hostPartner    User?   @relation("EventHost", fields: [hostPartnerId], references: [id])
  mapUrl         String?
  dressCode      String?
  arrivalNote    String?

  questionReplies EventQuestionReply[]
  attendances EventAttendance[]
  ticketTypes EventTicketType[]
  blasts      EventBlast[]
  photos      EventPhoto[]
}

// Admin-uploaded only — no member upload path. Visible only to members who
// attended (joined) this specific event, the same rule already used for
// the attendee list. thumbnailUrl is null when a thumbnail couldn't be
// generated (e.g. a HEIC file this environment's image library can't
// decode) — the gallery falls back to the original in that case.
model EventPhoto {
  id           String   @id @default(cuid())
  eventId      String
  event        Event    @relation(fields: [eventId], references: [id])
  url          String
  thumbnailUrl String?
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
}

// A record of one "message all registrants" send from Admin > Events >
// Blasts — kept separate from the per-recipient Message rows it fans out to,
// so admins can see the send itself (who sent it, when, to how many) as a
// single entry rather than reconstructing it from the messages table.
model EventBlast {
  id              String   @id @default(cuid())
  eventId         String
  event           Event    @relation(fields: [eventId], references: [id])
  authorId        String
  author          User     @relation(fields: [authorId], references: [id])
  body            String
  includeWaitlist Boolean  @default(false)
  recipientCount  Int
  createdAt       DateTime @default(now())
}

// A named registration tier for an event (e.g. "General", "VIP"). Optional —
// an event with none uses its own capacity/approval settings directly.
// No payment processing here; these are access categories, not checkout.
model EventTicketType {
  id        String @id @default(cuid())
  eventId   String
  event     Event  @relation(fields: [eventId], references: [id])
  name      String
  // Null means it shares the event's own overall capacity rather than
  // having its own sub-limit.
  capacity  Int?
  sortOrder Int    @default(0)
  createdAt DateTime @default(now())

  attendances EventAttendance[]
}

model EventAttendance {
  id            String           @id @default(cuid())
  eventId       String
  event         Event            @relation(fields: [eventId], references: [id])
  memberId      String
  member        User             @relation(fields: [memberId], references: [id])
  ticketTypeId  String?
  ticketType    EventTicketType? @relation(fields: [ticketTypeId], references: [id])
  joined        Boolean          @default(false)

  // Guests the member is bringing, in addition to themselves. For an
  // invite-only event with named guests (see guestNames), this is derived
  // from guestNames.length rather than entered directly.
  guestCount Int @default(0)

  // Set instead of joined=true once the event's capacity is full at the
  // time they tried to join. Cleared automatically if a spot opens up and
  // they're promoted (first-come, first-served by createdAt).
  waitlisted Boolean @default(false)

  // Set instead of joined=true when the event (or its ticket type) requires
  // approval. An admin flips this to joined=true (approve) or deletes the
  // row (decline).
  pendingApproval Boolean @default(false)

  // JSON-encoded array of { question, answer } pairs, captured at RSVP time
  // against Event.registrationQuestions. Kept as a self-contained snapshot
  // so it stays correct even if the questions list changes later.
  registrationAnswers String?

  // Set by an admin when the member is manually checked in at the door.
  checkedInAt DateTime?

  // Set once an entry has been created on the connected Google Calendar for
  // this RSVP (mirrors Booking.googleCalendarEventId) — null until joined.
  googleCalendarEventId String?

  // Set by an admin to grant access to an invite-only event, independent of
  // joined — a member can be invited without having joined yet.
  invited Boolean @default(false)

  // When the invitation was released to the member. An invited row with no
  // invitationSentAt is a name on the admin's list only: the member cannot
  // see the event until it is sent.
  invitationSentAt DateTime?

  // Set when the member declines an invitation (or withdraws after
  // accepting). Cleared if they accept again.
  declinedAt DateTime?

  // Richer RSVP detail, collected on join. Only surfaced in the UI for
  // invite-only / Annual Gathering-style events, but generic on the model
  // so any event can use them.
  dietaryNotes String?
  travelNotes  String?
  arrivalDate  DateTime?
  // JSON-encoded array of named guests, replacing the anonymous guestCount
  // number for events where who's coming matters (e.g. the Annual
  // Gathering) — same parse/stringify-at-the-boundary convention as
  // elsewhere in this schema.
  guestNames String?

  // Post-event survey — sent 24 hours after the event ends to confirmed
  // (joined) attendees, one reminder at 3 days if unanswered, then no
  // further nagging (see the /api/cron/event-surveys job). surveyRating is
  // the required 1-5 question; surveyFeedback is the optional free-text one.
  surveySentAt         DateTime?
  surveyReminderSentAt DateTime?
  surveyRating         Int?
  surveyFeedback       String?
  surveyRespondedAt    DateTime?

  createdAt DateTime @default(now())

  @@unique([eventId, memberId])
}

// One thread per member with the RM, plus one further thread per member
// per partner who has messaged them.
// partnerId is null for the RM thread; set to a specific partner's id for
// that partner's own private thread with this member.
model Message {
  id         String   @id @default(cuid())
  memberId   String
  member     User     @relation("MemberThread", fields: [memberId], references: [id])
  partnerId  String?
  partner    User?    @relation("PartnerThread", fields: [partnerId], references: [id])
  // SenderRole: "MEMBER" | "RM" | "PARTNER"
  senderRole String
  authorId   String
  author     User     @relation("MessageAuthor", fields: [authorId], references: [id])
  body       String
  // True once the recipient has opened this thread since the message was
  // sent. Drives the unread badges in both apps' nav and inbox list.
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())
}

// The minimal in-app notification system. "new_message" is deliberately
// never created here — see packages/core/src/notifications.ts — a new
// message already has its own unread signal (Message.read); the types
// that actually fire today are "event_cancelled", "event_survey", and
// "member_inactive".
model Notification {
  id              String    @id @default(cuid())
  recipientId     String
  recipient       User      @relation(fields: [recipientId], references: [id])
  // Type: "new_message" | "event_cancelled" | "member_inactive" |
  // "intro_request" | "event_survey"
  type            String
  message         String
  relatedEntityType String?
  relatedEntityId   String?
  readAt          DateTime?
  createdAt       DateTime  @default(now())
}

// A partner or admin's written note: a title, a one-line subheading, an
// optional hero image (shown inline, not as a download), and the body.
model InsightPost {
  id          String    @id @default(cuid())
  title       String
  subheading  String?
  imageUrl    String?
  body        String
  // JSON-encoded array of freeform tag strings, admin-set at write time.
  // Same parse/stringify-at-the-boundary convention as elsewhere in this
  // schema.
  tags        String?
  authorId    String
  author      User      @relation(fields: [authorId], references: [id])
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Status: "IN_REVIEW" | "PUBLISHED" | "REJECTED". A post by a full admin
  // (Owner/RM) publishes immediately with no review step. A partner's post
  // starts (and any resubmission after a rejection returns to) IN_REVIEW
  // until a full admin approves or rejects it. Default here is PUBLISHED so
  // posts that existed before this field was added stay visible as-is.
  status     String  @default("PUBLISHED")
  // Set by a full admin when rejecting an IN_REVIEW post, so the author
  // knows what to fix before resubmitting.
  reviewNote String?

  bookmarks InsightBookmark[]
  views     InsightView[]
}

// A saved reply snippet that can be dropped into a message thread instead
// of typing the same thing out each time.
model CannedResponse {
  id        String   @id @default(cuid())
  title     String
  body      String

  // Audience: "ADMIN" | "PARTNER". RM and Owner share one ADMIN set,
  // editable by either. Partners get their own separate PARTNER set —
  // they only see their own member threads and their use case differs.
  // Not scoped to whoever created it beyond that split.
  audience String @default("ADMIN")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A member saving a post for later. One row per (member, post).
model InsightBookmark {
  id        String      @id @default(cuid())
  memberId  String
  member    User        @relation(fields: [memberId], references: [id])
  postId    String
  post      InsightPost @relation(fields: [postId], references: [id])
  createdAt DateTime    @default(now())

  @@unique([memberId, postId])
}

// One row per (member, post) the first time that member opens a post —
// the view count is this table's row count per post, not a page-load
// counter, so re-reading the same post never inflates it.
model InsightView {
  id        String      @id @default(cuid())
  memberId  String
  member    User        @relation(fields: [memberId], references: [id])
  postId    String
  post      InsightPost @relation(fields: [postId], references: [id])
  createdAt DateTime    @default(now())

  @@unique([memberId, postId])
}

// One row each time a member's seat is filled — powers the Room's
// one-time "Seat 11 was taken on Tuesday" caption. Not a log of every
// seating change, just new-member arrivals.
model RoomEvent {
  id       String   @id @default(cuid())
  memberId String
  member   User     @relation("RoomEventMember", fields: [memberId], references: [id])
  filledAt DateTime @default(now())

  views RoomEventView[]
}

// Marks that a given member has already seen a given RoomEvent's caption —
// "show once per member, then never again" per member, not once globally.
model RoomEventView {
  id          String    @id @default(cuid())
  roomEventId String
  roomEvent   RoomEvent @relation(fields: [roomEventId], references: [id])
  viewerId    String
  viewer      User      @relation("RoomEventViewer", fields: [viewerId], references: [id])
  seenAt      DateTime  @default(now())

  @@unique([roomEventId, viewerId])
}

// Singleton row (id is always "singleton") for app-wide toggles that don't
// belong to any one member or partner — starts with just the Room's
// optional, name-free activity pulse line.
// A member's private reply to a dinner's question. One per member per event,
// editable. Read only by the event's host partner.
model EventQuestionReply {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id])
  memberId  String
  member    User     @relation(fields: [memberId], references: [id])
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, memberId])
}

// "Ask the table" on Home. Introductions keep their own model; this holds the
// rest. Type: "BRIEF" | "PEER_HOUR" | "RESTAURANT". Status: "NEW" | "IN_PROGRESS" | "DONE".
model TableRequest {
  id        String   @id @default(cuid())
  memberId  String
  member    User     @relation(fields: [memberId], references: [id])
  type      String
  details   String
  status    String   @default("NEW")
  adminNote String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Time a partner has marked as not available, on top of whatever their Table
// hours say. Until Google Calendar sync is on this is where "correct my
// availability" lives; afterwards it can mirror into Google.
model AvailabilityBlock {
  id        String   @id @default(cuid())
  partnerId String
  partner   User     @relation(fields: [partnerId], references: [id])
  startTime DateTime
  endTime   DateTime
  createdAt DateTime @default(now())

  @@index([partnerId, startTime])
}

model AppSettings {
  id               String   @id @default("singleton")
  roomPulseEnabled Boolean  @default(true)
  // Last Notion sync, for the admin status line.
  notionLastSyncAt      DateTime?
  notionLastSyncSummary String?
  // The book of the year, shown on the member Home. Empty until set.
  bookTitle    String?
  bookAuthor   String?
  bookDinnerAt DateTime?
  // Crisis access, shown quietly in the member's Settings. Empty means the
  // app's built-in wording is used. Edited by admin in Settings.
  // No longer used: the Hour is now online or in person, with no default place.
  hourPlace           String?
  crisisAccessText    String?
  crisisAccessContact String?
  updatedAt        DateTime @updatedAt
}

